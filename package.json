{
  "name": "partx-file-splitter",
  "version": "1.0.0",
  "description": "Modern, high-performance Fluent Design File Splitter & Joiner for Windows with SHA-256 verification.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/engine.test.js",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "file-splitter",
    "file-joiner",
    "fluent-design",
    "electron",
    "checksum",
    "sha256",
    "windows-tools"
  ],
  "author": "Open Source Community",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "PartX.FileSplitter",
    "productName": "PartX",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "msi",
        "appx"
      ]
    },
    "appx": {
      "applicationId": "PartXFileSplitter",
      "identityName": "DhruvGupta.PartX-FileSplitterJoiner",
      "publisher": "CN=CB32F928-2859-4967-B8F7-396A9964D1FB",
      "publisherDisplayName": "Dhruv Gupta",
      "backgroundColor": "#0f172a"
    }

  }
}

